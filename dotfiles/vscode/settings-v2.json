{
    // Workbench UI Settings
    "workbench.settings.editor": "json", // Open settings in JSON format
    "workbench.settings.openDefaultSettings": true, // Allow viewing default settings
    "workbench.settings.useSplitJSON": true, // Use split JSON editor for settings
    "workbench.statusBar.visible": true, // Show status bar
    "workbench.startupEditor": "none", // No editor open on startup
    "workbench.colorTheme": "Gruvbox Dark Hard", // Set color theme
    "workbench.sideBar.location": "right", // Move sidebar to the right
    "workbench.iconTheme": "material-icon-theme", // Use Material Icons Theme
    "workbench.colorCustomizations": {
        "activityBarBadge.background": "#2979FF",
        "activityBar.activeBorder": "#2979FF",
        "list.activeSelectionForeground": "#2979FF",
        "list.inactiveSelectionForeground": "#2979FF",
        "list.highlightForeground": "#2979FF",
        "scrollbarSlider.activeBackground": "#2979FF50",
        "editorSuggestWidget.highlightForeground": "#2979FF",
        "textLink.foreground": "#2979FF",
        "progressBar.background": "#2979FF",
        "pickerGroup.foreground": "#2979FF",
        "tab.activeBorder": "#2979FF",
        "notificationLink.foreground": "#2979FF",
        "editorWidget.resizeBorder": "#2979FF",
        "editorWidget.border": "#2979FF",
        "settings.modifiedItemIndicator": "#2979FF",
        "settings.headerForeground": "#2979FF",
        "panelTitle.activeBorder": "#2979FF",
        "breadcrumb.activeSelectionForeground": "#2979FF",
        "menu.selectionForeground": "#2979FF",
        "menubar.selectionForeground": "#2979FF",
        "editor.findMatchBorder": "#2979FF",
        "selection.background": "#2979FF40"
    },
    // Editor Settings
    "editor.multiCursorModifier": "ctrlCmd", // Use Cmd/Ctrl for multi-cursor
    "editor.foldingStrategy": "indentation", // Fold code based on indentation
    "editor.minimap.enabled": false, // Disable minimap
    "editor.fontSize": 16, // Set font size
    "editor.fontFamily": "Fira Code", // Set font family
    "editor.fontLigatures": true, // Enable font ligatures
    "editor.formatOnPaste": true, // Auto-format on paste
    "editor.snippetSuggestions": "top", // Show snippet suggestions first
    "editor.insertSpaces": true, // Use spaces instead of tabs
    "editor.detectIndentation": false, // Do not auto-detect indentation
    "editor.renderWhitespace": "all", // Show all whitespace characters
    "editor.cursorSmoothCaretAnimation": "on", // Enable smooth cursor movement
    "editor.cursorBlinking": "expand", // Expand blinking cursor
    "editor.suggestSelection": "first", // Select first suggestion
    "editor.inlineSuggest.enabled": true, // Enable inline suggestions

    // Debug Console
    "debug.console.fontSize": 14, // Set debug console font size

    // Terminal Settings
    "terminal.integrated.fontSize": 16, // Set terminal font size
    "terminal.integrated.inheritEnv": false, // Do not inherit environment variables

    // File Settings
    "files.autoSave": "onFocusChange", // Auto-save files when focus changes
    "files.exclude": {
        // Exclude unnecessary files from explorer
        "**/__pycache__": true,
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.hg": true,
        "**/.metadata": true,
        "**/.project": true,
        "**/.pydevproject": true,
        "**/.svn": true,
        "**/*.class": true,
        "**/CVS": true
    },

    // Language-Specific Settings
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[yaml]": {
        "editor.formatOnSave": true
    },
    "[typescript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[python]": {
        "editor.formatOnType": true
    },
    "[markdown]": {
        "editor.wordWrap": "off",
        "editor.tabSize": 4,
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.wordWrapColumn": 80
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },

    // Markdown Preview Settings
    "markdown-preview-enhanced.hideDefaultVSCodeMarkdownPreviewButtons": false,
    "markdown-preview-enhanced.codeBlockTheme": "one-dark.css",
    "markdown-preview-enhanced.previewTheme": "atom-dark.css",
    "markdown-preview-enhanced.revealjsTheme": "blood.css",
    "markdown-preview-enhanced.enablePreviewZenMode": false,
    "markdown.extension.print.theme": "dark",
    "markdown.extension.toc.omittedFromToc": {},

    // Python Settings
    "python.jediEnabled": false, // Use Pylance instead of Jedi
    "python.analysis.typeCheckingMode": "off", // Disable type checking
    "python.languageServer": "Pylance", // Set language server to Pylance
    "python.terminal.activateEnvironment": false, // Disable automatic environment activation
    "python.defaultInterpreterPath": "/Users/am/.pyenv/versions/3.9.6/envs/dsnb", // Set default interpreter

    // Git Settings
    "git.openRepositoryInParentFolders": "never", // Prevent opening parent folder repositories

    // IntelliCode Settings
    "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",

    // Security Settings
    "security.workspace.trust.untrustedFiles": "open", // Open untrusted files

    // Extensions & Formatting
    "extensions.ignoreRecommendations": false, // Allow extension recommendations
    "prettier.tabWidth": 4, // Set tab width for Prettier
    "redhat.telemetry.enabled": false, // Disable Red Hat telemetry

    // Notebook Settings
    "notebook.editorOptionsCustomizations": {
        "editor.tabSize": 4,
        "editor.indentSize": 4,
        "editor.insertSpaces": true
    },
    "notebook.output.textLineLimit": 50, // Limit notebook output lines

    // Explorer Settings
    "explorer.confirmDragAndDrop": false, // Disable drag-and-drop confirmation

    // Live Server Settings
    "liveServer.settings.donotShowInfoMsg": true, // Hide info messages
    "liveServer.settings.CustomBrowser": "chrome", // Use Chrome for Live Server
    "liveServer.settings.AdvanceCustomBrowserCmdLine": "",

    // Miscellaneous Settings
    "breadcrumbs.enabled": true, // Enable breadcrumbs
    "diffEditor.hideUnchangedRegions.enabled": true, // Hide unchanged regions in diff editor
    "workbench.editorAssociations": {
        "*.db": "default" // Open database files with default editor
    },
    "chatgpt.gpt3.apiKey": "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" // API Key for ChatGPT (Consider removing from public config)
}
